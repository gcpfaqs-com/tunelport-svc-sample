#!/usr/bin/env bash
set -euo pipefail

# Colores para salida limpia en terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}[pre-commit]${NC} Ejecutando controles de seguridad..."

# 1. Comprobar que gitleaks está instalado
if ! command -v gitleaks >/dev/null 2>&1; then
  echo -e "${RED}✖ Error:${NC} 'gitleaks' no está instalado o no está en el PATH."
  exit 1
fi

# 2. Escaneo de secretos en los cambios staged
echo -e "${CYAN}→${NC} Escaneando secretos con Gitleaks..."
gitleaks protect --staged --redact

# 3. SAST en Go con gosec solo si hay archivos *.go staged
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')

if [ -n "$STAGED_GO_FILES" ]; then
  if ! command -v gosec >/dev/null 2>&1; then
    echo -e "${RED}✖ Error:${NC} Hay cambios en archivos Go, pero 'gosec' no está instalado o no está en el PATH."
    exit 1
  fi

  echo -e "${CYAN}→${NC} Cambios en Go detectados. Ejecutando gosec..."
  gosec -quiet -severity high -confidence medium ./...
else
  echo -e "${CYAN}→${NC} Sin cambios en archivos Go, omitiendo gosec."
fi

# 4. Escaneo SCA con Snyk solo si hay manifiestos/lockfiles en staged
STAGED_MANIFESTS=$(git diff --cached --name-only -- \
  'go.mod' 'go.sum' \
  'package.json' 'package-lock.json' 'yarn.lock' 'pnpm-lock.yaml' \
  'requirements.txt' 'pyproject.toml' 'poetry.lock' \
  'pom.xml' 'build.gradle' 'build.gradle.kts' \
  'Cargo.toml' 'Cargo.lock' \
  'Gemfile' 'Gemfile.lock' \
  'composer.json' 'composer.lock')

if [ -n "$STAGED_MANIFESTS" ]; then
  if ! command -v snyk >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ Aviso:${NC} Cambiaron dependencias, pero 'snyk' no está instalado en el PATH."
    exit 1
  fi

  echo -e "${CYAN}→${NC} Dependencias modificadas detectadas. Ejecutando Snyk SCA..."
  snyk test --severity-threshold=high --fail-on=upgradable
else
  echo -e "${CYAN}→${NC} Sin cambios en dependencias, omitiendo Snyk SCA."
fi

echo -e "${GREEN}✔ Pre-commit superado.${NC}"
